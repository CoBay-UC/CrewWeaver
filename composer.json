{
  "name": "crewweaver/crewweaver",
  "description": "Self-hosted multi-team project management and scheduling",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "CrewWeaver\\": ["app/", "lib/"]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CrewWeaver\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "@php bin/lint.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
