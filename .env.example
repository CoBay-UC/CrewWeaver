APP_ENV=production
APP_DEBUG=false
APP_URL=https://crewweaver.example.com
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=America/Edmonton
SESSION_NAME=crewweaver_session
SESSION_SECURE=true
SESSION_LIFETIME=7200

DB_HOST=db
DB_PORT=3306
DB_DATABASE=crewweaver
DB_USERNAME=crewweaver
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=crewweaver
OIDC_CLIENT_SECRET=replace-with-provider-secret
OIDC_REDIRECT_URI=https://crewweaver.example.com/auth/callback
OIDC_LOGOUT_URI=https://crewweaver.example.com/
OIDC_SCOPES=openid profile email
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_SUBJECT_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_GIVEN_NAME_CLAIM=given_name
OIDC_FAMILY_NAME_CLAIM=family_name
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_AVATAR_CLAIM=picture
OIDC_GROUPS_CLAIM=groups
OIDC_TRUSTED_APPROVED_GROUPS=
OIDC_TRUSTED_GLOBAL_ADMIN_GROUPS=
OIDC_BOOTSTRAP_ISSUER=https://id.example.com
OIDC_BOOTSTRAP_SUBJECT=replace-with-verified-subject

UPLOAD_MAX_BYTES=10485760
DEV_AUTH_ENABLED=false
DEV_AUTH_USER_ID=1
